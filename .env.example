# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos ---
# Local: mongodb://127.0.0.1:27017/construfash
MONGO_URI=mongodb://127.0.0.1:27017/construfash

# --- Autenticacion JWT ---
# Genera uno propio en produccion, ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_valor_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# --- Cloudinary (Sprint 2 - Evidencias fotograficas) ---
# Crea una cuenta gratuita en https://cloudinary.com y copia tus credenciales
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
# Carpeta raiz dentro de Cloudinary donde se guardan las fotos
CLOUDINARY_FOLDER=construfash

SEED_SUPERADMIN_EMAIL=superadmin@construfash.local
SEED_SUPERADMIN_PASSWORD=CambiarEsta123!

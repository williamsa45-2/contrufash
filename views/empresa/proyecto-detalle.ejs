<%
/* RF-07 - Vista de detalle de proyecto: Gantt planificado vs avance real
   con Chart.js (barras horizontales), resumen financiero y tabla de fases.
   El Gantt de Sprint 1 contrasta fechas planificadas con el avance_real
   de cada fase; los controles de edicion de avance se agregan en Sprint 2. */
%>

<% if (typeof mensaje !== 'undefined' && mensaje) { %>
  <div class="cf-alert cf-alert-success"><%= mensaje %></div>
<% } %>

<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:20px;">
  <div>
    <a href="/empresa/proyectos" class="cf-btn cf-btn-ghost cf-btn-sm" style="margin-bottom:10px;">
      ← Proyectos
    </a>
    <div class="hazard-stripe" style="margin-bottom:8px;"></div>
    <%
      const badgeClass = {
        planeado: 'cf-badge-info',
        en_progreso: 'cf-badge-warning',
        finalizado: 'cf-badge-success',
        cancelado: 'cf-badge-danger'
      }[proyecto.estado] || 'cf-badge-neutral';
    %>
    <span class="cf-badge <%= badgeClass %>"><%= proyecto.estado.replace('_', ' ') %></span>
    <% if (proyecto.descripcion) { %>
      <p style="margin:8px 0 0; font-size:0.88rem; color:var(--ink-700);"><%= proyecto.descripcion %></p>
    <% } %>
  </div>
  <div style="text-align:right; font-size:0.82rem; color:var(--ink-500);">
    Creado por: <strong><%= proyecto.creado_por ? proyecto.creado_por.nombre : '—' %></strong><br>
    <span class="font-mono"><%= new Date(proyecto.creado_en).toLocaleDateString('es-CO') %></span>
  </div>
</div>

<!-- Metricas del proyecto -->
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:24px;">
  <div class="cf-metric">
    <div class="label">Inicio</div>
    <div class="value font-mono" style="font-size:1.05rem;">
      <%= new Date(proyecto.fecha_inicio).toLocaleDateString('es-CO') %>
    </div>
  </div>
  <div class="cf-metric">
    <div class="label">Fin planificado</div>
    <div class="value font-mono" style="font-size:1.05rem;">
      <%= new Date(proyecto.fecha_fin).toLocaleDateString('es-CO') %>
    </div>
  </div>
  <div class="cf-metric">
    <div class="label">Fases</div>
    <div class="value"><%= (proyecto.fases || []).length %></div>
  </div>
  <div class="cf-metric">
    <div class="label">Avance real</div>
    <div class="value orange"><%= avanceReal %>%</div>
  </div>
  <div class="cf-metric">
    <div class="label">Presupuesto total</div>
    <div class="value" style="font-size:1rem; font-family:var(--font-mono);">
      $<%= (proyecto.presupuesto_total || 0).toLocaleString('es-CO') %>
    </div>
  </div>
</div>

<!-- Diagrama de Gantt (Chart.js barras horizontales) -->
<div class="cf-card" style="margin-bottom:20px;">
  <h2 style="margin:0 0 16px; font-size:1rem;">Cronograma de fases (Gantt)</h2>
  <% if (!ganttData.length) { %>
    <div class="cf-empty" style="border:none; padding:24px;">Sin fases para mostrar.</div>
  <% } else { %>
    <!-- Gantt simple: tabla de barras SVG, sin depender del CDN de Chart.js
         para que funcione offline (SRS RNF-01). En Sprint 2 se migrara al
         componente interactivo con edicion de avance desde campo. -->
    <%
      const proyInicio = new Date(proyecto.fecha_inicio).getTime();
      const proyFin    = new Date(proyecto.fecha_fin).getTime();
      const duracionTotal = proyFin - proyInicio || 1;
      const hoy = Date.now();
      const hoySobrepasadoPct = Math.max(0, Math.min(100, ((hoy - proyInicio) / duracionTotal) * 100));
    %>
    <div style="overflow-x:auto;">
      <div style="min-width:560px;">
        <!-- Cabecera: indicador de hoy -->
        <div style="position:relative; height:24px; margin-bottom:6px;">
          <div style="position:absolute; left:<%= hoySobrepasadoPct.toFixed(1) %>%; top:0; bottom:0; width:2px; background:var(--orange-600); z-index:2;"></div>
          <div style="position:absolute; left:<%= hoySobrepasadoPct.toFixed(1) %>%; top:0; background:var(--orange-600); color:#fff; font-family:var(--font-mono); font-size:0.66rem; padding:2px 5px; border-radius:3px; white-space:nowrap; transform:translateX(-50%);">
            Hoy
          </div>
        </div>

        <% ganttData.forEach(function(fase, i) {
            const faseInicio = new Date(fase.inicio).getTime();
            const faseFin    = new Date(fase.fin).getTime();
            const left = Math.max(0, ((faseInicio - proyInicio) / duracionTotal) * 100);
            const width = Math.min(100 - left, ((faseFin - faseInicio) / duracionTotal) * 100);
            const realWidth = width * (fase.avance_real / 100);
            const estadoColor = {
              pendiente: 'var(--blueprint-500)',
              en_progreso: 'var(--warning-600)',
              completada: 'var(--success-600)'
            }[fase.estado] || 'var(--ink-500)';
        %>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
            <div style="width:160px; flex-shrink:0; font-size:0.82rem; font-weight:600; text-align:right; color:var(--ink-700); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= fase.nombre %>">
              <%= fase.nombre %>
            </div>
            <div style="flex:1; position:relative; height:20px;">
              <!-- Barra planificada (fondo) -->
              <div style="position:absolute; left:<%= left.toFixed(1) %>%; width:<%= width.toFixed(1) %>%; height:100%; background:<%= estadoColor %>; opacity:0.22; border-radius:3px;"></div>
              <!-- Barra avance real -->
              <div style="position:absolute; left:<%= left.toFixed(1) %>%; width:<%= realWidth.toFixed(1) %>%; height:100%; background:<%= estadoColor %>; border-radius:3px;"></div>
              <!-- Texto porcentaje -->
              <div style="position:absolute; left:<%= (left + width + 1).toFixed(1) %>%; top:50%; transform:translateY(-50%); font-family:var(--font-mono); font-size:0.7rem; color:var(--ink-700); white-space:nowrap;">
                <%= fase.avance_real %>% real / <%= fase.planificado %>% plan
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    <!-- Leyenda -->
    <div style="margin-top:12px; display:flex; gap:18px; font-size:0.76rem; color:var(--ink-500);">
      <span style="display:flex;align-items:center;gap:4px;"><span style="display:inline-block;width:14px;height:8px;border-radius:2px;background:var(--blueprint-500);opacity:0.3;"></span>Planificado</span>
      <span style="display:flex;align-items:center;gap:4px;"><span style="display:inline-block;width:14px;height:8px;border-radius:2px;background:var(--blueprint-500);"></span>Avance real</span>
    </div>
  <% } %>
</div>

<!-- Tabla detalle de fases -->
<div class="cf-card">
  <h2 style="margin:0 0 14px; font-size:1rem;">Detalle de fases</h2>
  <% if (!proyecto.fases || !proyecto.fases.length) { %>
    <div class="cf-empty" style="border:none; padding:20px;">Este proyecto no tiene fases registradas.</div>
  <% } else { %>
    <table class="cf-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Fase</th>
          <th>Inicio</th>
          <th>Fin</th>
          <th>Presupuesto</th>
          <th>Personal</th>
          <th>Estado</th>
          <th>Avance real</th>
        </tr>
      </thead>
      <tbody>
        <% proyecto.fases.sort(function(a,b){return a.orden - b.orden;}).forEach(function(f, i) {
           const fBadge = {
             pendiente: 'cf-badge-info',
             en_progreso: 'cf-badge-warning',
             completada: 'cf-badge-success'
           }[f.estado] || 'cf-badge-neutral';
        %>
          <tr>
            <td style="font-family:var(--font-mono); font-size:0.8rem; color:var(--ink-500);"><%= i + 1 %></td>
            <td style="font-weight:600;"><%= f.nombre %></td>
            <td style="font-size:0.82rem;"><%= new Date(f.fecha_inicio).toLocaleDateString('es-CO') %></td>
            <td style="font-size:0.82rem;"><%= new Date(f.fecha_fin).toLocaleDateString('es-CO') %></td>
            <td style="font-family:var(--font-mono); font-size:0.82rem;">
              $<%= (f.presupuesto_asignado || 0).toLocaleString('es-CO') %>
            </td>
            <td style="font-size:0.8rem;">
              <% if (f.personal_asignado && f.personal_asignado.length) { %>
                <% f.personal_asignado.slice(0,3).forEach(function(p) { %>
                  <div><%= p.nombre %></div>
                <% }); %>
                <% if (f.personal_asignado.length > 3) { %>
                  <span style="color:var(--ink-500);">+ <%= f.personal_asignado.length - 3 %> mas</span>
                <% } %>
              <% } else { %>
                <span style="color:var(--ink-500);">—</span>
              <% } %>
            </td>
            <td><span class="cf-badge <%= fBadge %>"><%= f.estado.replace('_',' ') %></span></td>
            <td>
              <div style="display:flex; align-items:center; gap:6px;">
                <div style="width:60px; height:5px; background:var(--line); border-radius:3px;">
                  <div style="width:<%= f.avance_real %>%; height:100%; background:var(--orange-600); border-radius:3px;"></div>
                </div>
                <span class="font-mono" style="font-size:0.76rem;"><%= f.avance_real %>%</span>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

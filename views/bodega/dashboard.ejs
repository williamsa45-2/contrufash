<%
/* SAD 2.1.3 - Panel del Almacenista. Flujo de materiales en Sprint 3. */
%>

<div style="margin-bottom:16px;">
  <div class="hazard-stripe" style="margin-bottom:12px;"></div>
  <p style="font-size:0.88rem; color:var(--ink-700); margin:0;">
    Panel de control de inventario y despacho de materiales.
  </p>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; margin-bottom:24px;">
  <div class="cf-metric">
    <div class="label">Solicitudes pendientes</div>
    <div class="value orange">—</div>
  </div>
  <div class="cf-metric">
    <div class="label">Despachos hoy</div>
    <div class="value">—</div>
  </div>
</div>

<div class="cf-card" style="background:var(--blueprint-100); border-color:var(--blueprint-500);">
  <p style="margin:0; font-size:0.86rem; color:var(--blueprint-500);">
    <strong>Sprint 3:</strong> Aqui apareceran las ordenes de despacho autorizadas por el Admin,
    el registro de salidas con foto de evidencia (Cloudinary) y el kardex de materiales
    (SAD 2.1.3 — RF-11, RF-12, RF-13).
  </p>
</div>

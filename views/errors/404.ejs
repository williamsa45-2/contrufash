<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= title %> · ConstruFash</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--ink-900);">
    <div style="max-width:420px; text-align:center; background:var(--paper-card); border-radius:10px; padding:36px 30px; box-shadow:0 24px 60px rgba(0,0,0,.35);">
      <div class="hazard-stripe" style="margin-bottom:18px;"></div>
      <h1 style="margin:0 0 8px;"><%= title %></h1>
      <p style="color:var(--ink-700); font-size:0.92rem;"><%= mensaje %></p>
      <a class="cf-btn cf-btn-primary" style="margin-top:12px;" href="/">Volver al inicio</a>
    </div>
  </div>
</body>
</html>

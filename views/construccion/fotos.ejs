<%
/* RF-14: Fotos de cumplimiento del Constructor */
const badgeEstado = { pendiente_revision:'cf-badge-warning', aprobada:'cf-badge-success', rechazada:'cf-badge-danger' };
const labelEstado = { pendiente_revision:'Pendiente revisión', aprobada:'Aprobada', rechazada:'Rechazada' };
%>

<div style="max-width:640px;">
  <a href="/construccion/dashboard" class="cf-btn cf-btn-ghost cf-btn-sm" style="margin-bottom:16px;">← Mis actividades</a>

  <div class="cf-card" style="margin-bottom:18px; border-left:4px solid var(--orange-600);">
    <div style="font-family:var(--font-mono); font-size:0.72rem; color:var(--ink-500);">PROYECTO · FASE</div>
    <div style="font-weight:600;"><%= proyecto.nombre %> — <%= fase.nombre %></div>
  </div>

  <div id="msg-ok" class="cf-alert cf-alert-success" style="display:none;"></div>
  <div id="msg-err" class="cf-alert cf-alert-error" style="display:none;"></div>

  <!-- Formulario de subida -->
  <div class="cf-card" style="margin-bottom:24px;">
    <h2 style="margin:0 0 16px; font-size:1rem;">Subir foto de cumplimiento</h2>
    <div class="cf-field">
      <label>Descripción del trabajo realizado <span style="color:var(--orange-600);">*</span></label>
      <textarea id="desc-input" rows="2" placeholder="Ej: Vaciado de concreto columna C3 terminado" style="resize:vertical;"></textarea>
    </div>
    <div class="cf-field">
      <label>Foto <span style="color:var(--orange-600);">*</span></label>
      <input type="file" id="foto-input" accept="image/*" capture="environment" style="padding:5px 0;">
      <div id="foto-preview" style="display:none; margin-top:10px;">
        <img id="preview-img" style="max-width:100%; max-height:200px; border-radius:6px; border:1px solid var(--line);">
      </div>
      <div class="hint">Se comprime automáticamente. Máximo 12 MB.</div>
    </div>
    <button id="btn-subir" class="cf-btn cf-btn-primary" style="width:100%; justify-content:center; padding:11px;">
      Enviar foto al Jefe de Obra
    </button>
  </div>

  <!-- Galería de fotos enviadas -->
  <div class="cf-card">
    <h2 style="margin:0 0 14px; font-size:1rem;">Mis fotos enviadas (<%= fotos.length %>)</h2>
    <% if (!fotos.length) { %>
      <div style="color:var(--ink-500); font-size:0.86rem;">Aún no has subido fotos para esta fase.</div>
    <% } else { %>
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:12px;">
        <% fotos.forEach(function(f) { %>
          <div style="border:1px solid var(--line); border-radius:8px; overflow:hidden;">
            <a href="<%= f.foto.url %>" target="_blank">
              <img src="<%= f.foto.url %>" alt="Foto de cumplimiento"
                   style="width:100%; height:130px; object-fit:cover; display:block;">
            </a>
            <div style="padding:8px 10px;">
              <div style="font-size:0.8rem; font-weight:600; margin-bottom:4px; color:var(--ink-900);">
                <%= f.descripcion %>
              </div>
              <span class="cf-badge <%= badgeEstado[f.estado] %>">
                <%= labelEstado[f.estado] %>
              </span>
              <% if (f.comentario) { %>
                <div style="margin-top:6px; font-size:0.74rem; color:var(--ink-500);">
                  Jefe: "<%= f.comentario %>"
                </div>
              <% } %>
              <div style="margin-top:4px; font-family:var(--font-mono); font-size:0.68rem; color:var(--ink-500);">
                <%= new Date(f.creado_en).toLocaleDateString('es-CO') %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<script>
(function () {
  const PROYECTO_ID = '<%= proyecto._id %>';
  const FASE_ID     = '<%= fase._id %>';
  const token = localStorage.getItem('cf_token') || '';
  const fotoInput  = document.getElementById('foto-input');
  const prevDiv    = document.getElementById('foto-preview');
  const prevImg    = document.getElementById('preview-img');
  const msgOk      = document.getElementById('msg-ok');
  const msgErr     = document.getElementById('msg-err');

  fotoInput.addEventListener('change', function () {
    const file = this.files[0];
    if (!file) { prevDiv.style.display='none'; return; }
    const reader = new FileReader();
    reader.onload = e => { prevImg.src = e.target.result; prevDiv.style.display='block'; };
    reader.readAsDataURL(file);
  });

  document.getElementById('btn-subir').addEventListener('click', async function () {
    msgOk.style.display='none'; msgErr.style.display='none';
    const desc  = document.getElementById('desc-input').value.trim();
    const foto  = fotoInput.files[0];
    if (!desc) { msgErr.textContent='La descripción es obligatoria.'; msgErr.style.display='block'; return; }
    if (!foto)  { msgErr.textContent='Selecciona una foto.'; msgErr.style.display='block'; return; }

    this.disabled=true; this.textContent='Subiendo...';
    try {
      const fd = new FormData();
      fd.append('proyecto_id', PROYECTO_ID);
      fd.append('fase_id', FASE_ID);
      fd.append('descripcion', desc);
      fd.append('foto', foto);
      const res = await fetch('/api/construccion/fotos', {
        method:'POST', headers:{ Authorization:'Bearer '+token }, body: fd,
      });
      const data = await res.json();
      if (!res.ok||!data.ok) throw new Error(data.mensaje);
      msgOk.textContent='✓ Foto enviada. El Jefe de Obra la revisará.'; msgOk.style.display='block';
      document.getElementById('desc-input').value='';
      fotoInput.value=''; prevDiv.style.display='none';
      setTimeout(() => location.reload(), 1800);
    } catch(err) { msgErr.textContent=err.message; msgErr.style.display='block'; }
    finally { this.disabled=false; this.textContent='Enviar foto al Jefe de Obra'; }
  });
})();
</script>
